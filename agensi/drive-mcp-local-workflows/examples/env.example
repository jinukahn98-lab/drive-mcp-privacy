# Optional environment variables used by some Google Workspace MCP servers.
# Copy to your shell or MCP client env block. Never commit real values.

# Path to OAuth client JSON downloaded from Google Cloud Console (Desktop app).
GOOGLE_OAUTH_KEYS_PATH=/home/you/.config/drive-mcp-local/gcp-oauth.keys.json

# Path where the MCP server stores refresh tokens after browser consent.
GOOGLE_TOKENS_PATH=/home/you/.config/drive-mcp-local/tokens.json

# Some servers accept an explicit config directory instead of separate paths.
# GOOGLE_DRIVE_MCP_CONFIG_DIR=/home/you/.config/drive-mcp-local
